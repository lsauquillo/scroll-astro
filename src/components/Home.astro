---
const {
  title = "Home",
  subtitle = "Subtítulo",
  description = "Descripción",
  image = "/images/unsplash_1.jpg",
} = Astro.props;
---

<section id="home" class="flex min-h-screen items-center justify-center px-6 pt-24">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 md:grid-cols-2">
    <div>
      <h1 class="text-5xl font-bold">{title}</h1>
      <h2 class="mt-4 text-2xl font-semibold text-slate-300">{subtitle}</h2>
      <p class="mt-6 text-lg text-slate-400">{description}</p>
    </div>

   <img
  src={image}
  alt="Imagen principal"
  class="w-full max-w-md rounded-2xl shadow-xl"
/>
  </div>
</section>